# Supabase 프로젝트 설정 > API 에서 확인할 수 있습니다.
# 이 파일을 .env.local로 복사해서 실제 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 네이버 클라우드플랫폼(NCP) Maps > Application 에서 확인할 수 있습니다. Client ID만 넣으세요 (Client Secret은 넣지 않습니다 — 서버 간 API에만 쓰는 값이라 이 앱에는 필요 없고, 클라이언트에 노출되면 안 됩니다).
# 일부러 VITE_ 접두사를 안 붙였습니다 — Vercel이 VITE_로 시작하는 이름은 "공개 노출"
# 경고와 함께 저장을 막는 경우가 있는데, 이 값은 원래 공개돼도 안전한 값이라 이 이름 그대로
# Vercel에 등록하세요 (vite.config.ts의 envPrefix 설정으로 이 이름도 클라이언트에 노출됩니다).
NAVER_MAP_CLIENT_ID=xxxxxxxxxx
